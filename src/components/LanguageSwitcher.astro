---
import { getLocalizedPathname, LANGUAGES, type UiType } from "../i18n/utils";

interface Props {
    lang: UiType;
}

const { lang } = Astro.props;
const langs = Object.keys(LANGUAGES) as UiType[];
---

<span class="switch">
    {
        langs.map((l, i) => (
            <>
                {i > 0 && <span aria-hidden="true">/</span>}
                {l === lang ? (
                    <span class="current" aria-current="true">{l.toUpperCase()}</span>
                ) : (
                    <a
                        href={getLocalizedPathname(Astro.url.pathname, l)}
                        hreflang={l}
                        lang={l}
                        aria-label={LANGUAGES[l]}
                    >
                        {l.toUpperCase()}
                    </a>
                )}
            </>
        ))
    }
</span>

<style>
    .switch {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 14px;
        color: var(--muted);
    }
    .switch a {
        padding: 10px 2px;
    }
    .current {
        color: var(--fg);
        font-weight: 700;
        border-bottom: 2px solid var(--accent);
    }
</style>
