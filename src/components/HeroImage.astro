---
import { Image } from "astro:assets";

interface Props {
    heroImage?: string;
    heroGif?: string;
}

const { heroImage, heroGif } = Astro.props;
---

{
    heroImage && (
        <div class="hero">
            <Image src={heroImage} alt="" width={1400} height={600} loading="eager" fetchpriority="high" />
            {heroGif && (
                <Image class="gif" src={heroGif} alt="" width={1400} height={600} onload="this.classList.add('visible')" />
            )}
        </div>
    )
}

<style>
    .hero {
        position: relative;
        overflow: hidden;
        background: var(--code-bg);
    }
    .hero :global(img) {
        width: 100%;
        height: auto;
        aspect-ratio: 7 / 3;
        max-height: 460px;
        object-fit: cover;
    }
    .hero :global(.gif) {
        position: absolute;
        inset: 0;
        opacity: 0;
        transition: opacity 0.5s ease;
    }
    .hero :global(.gif.visible) {
        opacity: 1;
    }
    @media (prefers-reduced-motion: reduce) {
        .hero :global(.gif) {
            display: none;
        }
    }
</style>
