---
interface Props {
    label: string;
}

const { label } = Astro.props;
---

<button id="themeToggle" type="button" aria-label={label}>
    <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
    <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
    </svg>
</button>

<style>
    button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        padding: 0;
        border: 0;
        background: none;
        color: var(--fg);
        cursor: pointer;
    }
    button:hover {
        color: var(--accent);
    }
    .moon,
    :global(.dark) .sun {
        display: none;
    }
    :global(.dark) .moon {
        display: block;
    }
</style>

<script is:inline>
    (() => {
        const apply = () => {
            const theme =
                localStorage.getItem("theme") ??
                (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
            document.documentElement.classList.toggle("dark", theme === "dark");
        };
        // Délégation : survit aux échanges de page du ClientRouter
        if (!window.__themeToggle) {
            window.__themeToggle = true;
            document.addEventListener("click", (e) => {
                if (!e.target.closest?.("#themeToggle")) return;
                const next = document.documentElement.classList.contains("dark") ? "light" : "dark";
                localStorage.setItem("theme", next);
                apply();
            });
            document.addEventListener("astro:after-swap", apply);
        }
        apply();
    })();
</script>
