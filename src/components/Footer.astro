---
import { useTranslations, type UiType } from "../i18n/utils";

interface Props {
    lang: UiType;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="wrap">
    <div class="bar">
        <span>{t("footer.text", new Date().getFullYear())}</span>
        <span class="links">
            <a href="https://github.com/phaired/blog" target="_blank" rel="noopener">GitHub</a>
            <a href="/rss.xml">RSS</a>
        </span>
    </div>
</footer>

<style>
    .bar {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 12px;
        padding: 24px 0 40px;
        border-top: 2px solid var(--rule);
        font-size: 14px;
    }
    .links {
        display: flex;
        gap: 16px;
    }
    .links a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        margin: -12px 0;
    }
</style>
