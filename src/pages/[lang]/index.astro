---
import Page from "../../layouts/Page.astro";
import EntryRows from "../../components/EntryRows.astro";
import ProjectCards from "../../components/ProjectCards.astro";
import { getLangPaths, useTranslations, type UiType } from "../../i18n/utils";
import { getVisibleEntries } from "../../utils/content";

export const getStaticPaths = getLangPaths;

const lang = Astro.params.lang as UiType;
const t = useTranslations(lang);
const posts = await getVisibleEntries("blog", lang);
const projects = await getVisibleEntries("projects", lang);
const meta = [
    [t("home.meta.job.label"), t("home.meta.job")],
    [t("home.meta.city.label"), t("home.meta.city")],
    [t("home.meta.edu.label"), t("home.meta.edu")],
];
---

<Page lang={lang} title={t("site.title")} description={t("site.description")}>
    <section class="wrap hero">
        <h1 class="display">{t("home.hero")}<span class="dot">.</span></h1>
        <dl class="facts">
            {
                meta.map(([label, value]) => (
                    <div>
                        <dt class="eyebrow">{label}</dt>
                        <dd>{value}</dd>
                    </div>
                ))
            }
            <p class="lead">{t("home.lead")}</p>
        </dl>
    </section>

    <section class="wrap block" aria-labelledby="writing">
        <div class="head">
            <h2 id="writing">{t("nav.writing")}</h2>
            <a href={`/${lang}/blog/`} class="link-rule">{t("list.allPosts")} →</a>
        </div>
        <EntryRows kind="blog" entries={posts} />
    </section>

    <section class="wrap block" aria-labelledby="projects">
        <div class="head">
            <h2 id="projects">{t("nav.projects")}</h2>
            <a href={`/${lang}/projects/`} class="link-rule">{t("list.allProjects")} →</a>
        </div>
        <ProjectCards entries={projects} />
    </section>
</Page>

<style>
    .hero {
        padding-top: clamp(56px, 9vw, 96px);
        padding-bottom: 72px;
    }
    .hero h1 {
        font-size: clamp(56px, 10vw, 120px);
        max-width: 11ch;
    }
    .facts {
        display: flex;
        flex-wrap: wrap;
        gap: 24px 48px;
        margin: 48px 0 0;
        font-size: 15px;
    }
    .facts > * {
        flex: 1 1 200px;
        margin: 0;
        padding-top: 12px;
        border-top: 1px solid var(--rule);
    }
    .facts dd {
        margin: 4px 0 0;
    }
    .facts .lead {
        flex: 2 1 320px;
        font-size: 17px;
    }
    .block {
        padding-top: 64px;
        padding-bottom: 32px;
    }
    .block:last-child {
        padding-bottom: 96px;
    }
    .head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 24px;
    }
    .head h2 {
        font-size: 40px;
    }
</style>
