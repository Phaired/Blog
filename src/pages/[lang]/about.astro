---
import Layout from "../../layouts/Post.astro";
import { getLangPaths, useTranslations, type UiType } from "../../i18n/utils";

const lang = Astro.params.lang as UiType;
const t = useTranslations(lang);

export const getStaticPaths = getLangPaths;

const originalDate: Date = new Date(import.meta.env.BUILD_DATE);
const formattedDate: string = originalDate.toLocaleString("fr-FR", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
});
---

<Layout
    lang={lang}
    title={t("about.title")}
    description={t("about.description")}
    pubDate={new Date("September 25 2023")}
    heroImage=""
>
    <h4>{t("about.academic.title")}</h4>
    <p set:html={t("about.academic.text")} />

    <h5>{t("about.bts.title")}</h5>
    <p set:html={t("about.bts.text")} />

    <h5>{t("about.lp.title")}</h5>
    <p set:html={t("about.lp.text")} />

    <h5>{t("about.master.title")}</h5>
    <p set:html={t("about.master.text")} />

    <h4>{t("about.server.title")}</h4>
    <p set:html={t("about.server.text", formattedDate)} />
</Layout>
