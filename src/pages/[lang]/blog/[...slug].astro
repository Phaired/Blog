---
import { getCollection, render } from "astro:content";
import Post from "../../../layouts/Post.astro";
import { entrySlug, type Entry } from "../../../utils/content";

export async function getStaticPaths() {
    return (await getCollection("blog")).map((entry) => ({
        params: { lang: entry.data.lang, slug: entrySlug(entry) },
        props: { entry },
    }));
}

const { entry } = Astro.props as { entry: Entry };
const { Content, headings } = await render(entry);
---

<Post {...entry.data} headings={headings}>
    <Content />
</Post>
