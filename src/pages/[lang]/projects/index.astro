---
import Page from "../../../layouts/Page.astro";
import ProjectCards from "../../../components/ProjectCards.astro";
import { getLangPaths, useTranslations, type UiType } from "../../../i18n/utils";
import { getVisibleEntries } from "../../../utils/content";

export const getStaticPaths = getLangPaths;

const lang = Astro.params.lang as UiType;
const t = useTranslations(lang);
const entries = await getVisibleEntries("projects", lang);
---

<Page lang={lang} title={`${t("nav.projects")} · ${t("site.title")}`} description={t("site.description")}>
    <div class="wrap">
        <h1 class="display">{t("nav.projects")}<span class="dot">.</span></h1>
        {entries.length ? <ProjectCards entries={entries} /> : <p>{t("list.empty")}</p>}
    </div>
</Page>

<style>
    h1 {
        font-size: clamp(56px, 9vw, 104px);
        padding: clamp(48px, 8vw, 88px) 0 48px;
    }
    .wrap {
        padding-bottom: 96px;
    }
</style>
